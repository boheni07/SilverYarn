# 은빛실타래 (SilverYarn) — 환경변수 템플릿 (CONVENTIONS.md §4)
# 이 파일은 Git에 포함된다. 실제 값이 들어간 .env.local은 .gitignore 처리됨 (절대 커밋 금지).
# 온프레미스 시크릿(DB/Storage/LLM/VectorDB 접속정보)은 실 운영에서 시크릿 매니저 경유.

# --- DB_ (PostgreSQL) ---
# 포트는 이 머신에서 Docker 컨테이너에 열 수 있는 범위(9670-9680, 11개)에 맞춰
# infra/docker-compose.yml과 함께 정했다 — 기본 5432 등 표준 포트가 아니다.
DB_HOST=localhost
DB_PORT=9670
DB_NAME=silveryarn
DB_USER=silveryarn
DB_PASSWORD=silveryarn_local_dev

# --- STORAGE_ (MinIO) ---
STORAGE_ENDPOINT=localhost:9675
STORAGE_ACCESS_KEY=silveryarn
STORAGE_SECRET_KEY=silveryarn_local_dev
STORAGE_BUCKET_PHOTOS=silveryarn-photos
STORAGE_SECURE=false

# --- VECTORDB_ (Qdrant) ---
VECTORDB_HOST=localhost
VECTORDB_PORT=9672
VECTORDB_API_KEY=

# --- GRAPH_ (Neo4j, decisions.md #29) ---
GRAPH_URI=bolt://localhost:9674
GRAPH_USER=neo4j
GRAPH_PASSWORD=silveryarn_local_dev

# --- STT_ (Whisper Large-v3, 온프레미스) ---
STT_ENDPOINT=http://localhost:9001

# --- EMBEDDING_ (BGE-M3) ---
EMBEDDING_ENDPOINT=http://localhost:9002

# --- LLM_ (vLLM, 온프레미스 A100) ---
LLM_ENDPOINT=http://localhost:8001/v1
LLM_MODEL_NAME=

# --- AUTH_ (Keycloak SSO, decisions.md #17 / #47) ---
# AUTH_ISSUER_URL: Keycloak realm 발급자 URL. 비어 있으면 웹 콘솔 인증이 첫 호출에서
#   실패한다(fail closed). 모바일/워커 기동엔 영향 없음.
#   로컬(infra/docker-compose.yml의 keycloak, realm은 infra/keycloak/import에서 자동 임포트):
AUTH_ISSUER_URL=http://localhost:9678/realms/silveryarn
AUTH_CLIENT_ID=silveryarn-backend
AUTH_SECRET=
AUTH_AUDIENCE=                       # 비우면 AUTH_CLIENT_ID 사용
AUTH_JWKS_URL=                       # 비우면 {AUTH_ISSUER_URL}/protocol/openid-connect/certs
AUTH_2FA_AMR_VALUES=mfa,otp,hwk      # 토큰 amr claim에서 2FA로 인정할 값(Keycloak 인증흐름 설정에 맞춤)

# --- SYNC_ (배치 동기화, sync-contract.md) ---
SYNC_MAX_RETRY=5
SYNC_CHECKSUM_ALGO=sha256

# --- Worker (arq 잡 큐) ---
REDIS_HOST=localhost
REDIS_PORT=9671

# --- PII_ (PII 필드 암호화 KEK, decisions.md #45 / CONVENTIONS.md §4) ---
# PII 자유텍스트 컬럼(chapters.body_text 등 5개, schema.md §5)의 사용자별 DEK를
# 랩핑하는 마스터 키. 로컬 개발용 키를 하나 생성해 .env.local에 넣는다:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 회전 대비로 콤마 구분 다중 키 허용(첫 키로 암호화). 운영에서는 시크릿 매니저 경유.
PII_KEK=

# blind index(동등검색용 HMAC, contact_bidx 등) 전용 키 — decisions.md #60(2026-09-12).
# PII_KEK와 같은 값에서 유도하던 이전 방식(하나 유출 시 둘 다 노출)을 정식 분리했다.
# 로컬 개발용 키 생성은 PII_KEK와 동일한 방법. 비어 있으면 PII_KEK에서 유도하는
# 레거시 방식으로 폴백(경고 로그) — 새로 설정할 때는 scripts/backfill_blind_index.py로
# 기존 contact_bidx 값을 재계산해야 검색이 계속 맞는다.
BLIND_INDEX_KEY=

# --- CORS (apps/web "use client" 컴포넌트의 브라우저발 요청 허용) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- NEXT_PUBLIC_ (웹 클라이언트 노출, apps/web 스캐폴딩 시 사용) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# apps/admin이 초대 링크(/invitations/{token})를 조립할 때 쓰는 apps/web 주소
# (2026-09-11 신규, admin의 첫 쓰기 화면 — 가족 구성원 초대).
NEXT_PUBLIC_FAMILY_WEB_URL=http://localhost:3000
