# 은빛실타래 (SilverYarn) — 환경변수 템플릿 (CONVENTIONS.md §4)
# 이 파일은 Git에 포함된다. 실제 값이 들어간 .env.local은 .gitignore 처리됨 (절대 커밋 금지).
# 온프레미스 시크릿(DB/Storage/LLM/VectorDB 접속정보)은 실 운영에서 시크릿 매니저 경유.

# --- DB_ (PostgreSQL) ---
# 포트는 이 머신에서 Docker 컨테이너에 열 수 있는 범위(9670-9680, 11개)에 맞춰
# infra/docker-compose.yml과 함께 정했다 — 기본 5432 등 표준 포트가 아니다.
DB_HOST=localhost
DB_PORT=9670
DB_NAME=silveryarn
DB_USER=silveryarn
DB_PASSWORD=silveryarn_local_dev

# --- STORAGE_ (MinIO) ---
STORAGE_ENDPOINT=localhost:9675
STORAGE_ACCESS_KEY=silveryarn
STORAGE_SECRET_KEY=silveryarn_local_dev
STORAGE_BUCKET_PHOTOS=silveryarn-photos
STORAGE_SECURE=false

# --- VECTORDB_ (Qdrant) ---
VECTORDB_HOST=localhost
VECTORDB_PORT=9672
VECTORDB_API_KEY=

# --- GRAPH_ (Neo4j, decisions.md #29) ---
GRAPH_URI=bolt://localhost:9674
GRAPH_USER=neo4j
GRAPH_PASSWORD=silveryarn_local_dev

# --- STT_ (Whisper Large-v3, 온프레미스) ---
STT_ENDPOINT=http://localhost:9001

# --- EMBEDDING_ (BGE-M3) ---
EMBEDDING_ENDPOINT=http://localhost:9002

# --- LLM_ (vLLM, 온프레미스 A100) ---
LLM_ENDPOINT=http://localhost:8001/v1
LLM_MODEL_NAME=

# --- AUTH_ (Keycloak SSO, decisions.md #17) ---
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=silveryarn-backend
AUTH_SECRET=

# --- SYNC_ (배치 동기화, sync-contract.md) ---
SYNC_MAX_RETRY=5
SYNC_CHECKSUM_ALGO=sha256

# --- Worker (arq 잡 큐) ---
REDIS_HOST=localhost
REDIS_PORT=9671

# --- CORS (apps/web "use client" 컴포넌트의 브라우저발 요청 허용) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- NEXT_PUBLIC_ (웹 클라이언트 노출, apps/web 스캐폴딩 시 사용) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
