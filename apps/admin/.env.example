# apps/admin 전용 환경변수 — Next.js는 앱 자체 디렉터리의 .env 파일만 읽는다.
# 루트 .env.example(CONVENTIONS.md §4.2)이 모노레포 전체 SoR이며, 이 파일은
# 그 중 NEXT_PUBLIC_* 값을 이 앱이 실제로 읽을 수 있는 위치에 복사해 둔 것이다
# (apps/web/.env.example과 동일한 이유 — README 참조).

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Auth.js (Keycloak SSO, decisions.md #17/#49) ---
# 실제 값은 .env.local(gitignore)에. AUTH_SECRET은 `npx auth secret`으로 생성.
AUTH_SECRET=
AUTH_KEYCLOAK_ID=silveryarn-web
AUTH_KEYCLOAK_SECRET=                 # silveryarn-web은 public client라 빈 값
AUTH_KEYCLOAK_ISSUER=http://localhost:9678/realms/silveryarn
AUTH_URL=http://localhost:3001       # admin은 3001 (web은 3000)
